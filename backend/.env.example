# Blind AI Backend Environment Configuration Template
PORT=3000
ENVIRONMENT=development

# Google Gemini API Key
# Replace with your actual key from https://aistudio.google.com/
GEMINI_API_KEY=your_actual_key_here

# Supabase Configuration
# Replace with your project details from https://supabase.com/dashboard
SUPABASE_KEY=your_supabase_publishable_key_here
SUPABASE_URL=https://your-project-id.supabase.co

# AI Configuration
DEFAULT_AI_PROVIDER=gemini
GEMINI_MODEL=gemini-1.5-flash
MAX_TOKENS=300
TEMPERATURE=0.3
